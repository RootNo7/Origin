[application]
config/version="0.6.0-dev"
config/name="Origin"
config/description="Origin virtual universe — Godot 3.6-only CPU-first persistent 3D simulation and human test environment."
run/main_scene="res://observer/godot/scenes/Main.tscn"

[display]
window/size/width=1100
window/size/height=700
window/stretch/mode="2d"

[rendering]
renderer/driver/driver_name="GLES2"
textures/default_filters/use_nearest_mipmap_filter=false
