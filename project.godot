; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Origin"
config/description="Origin virtual universe — CPU-first authoritative 3D simulation with a Godot 3.6 human test client."
run/main_scene="res://observer/godot/scenes/Main.tscn"
config/version="0.3.0-dev"

[display]

window/size/width=1100
window/size/height=700
window/stretch/mode="2d"

[rendering]

renderer/driver/driver_name="GLES2"
